generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  name         String?
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("user")
}

model Service {
  id                String   @id @default(uuid())
  name              String
  slug              String   @unique
  description       String?  @db.Text
  image             String?  @db.Text
  imageAlt          String?
  secondaryImage    String?  @db.Text
  secondaryImageAlt String?
  status            String   @default("active")
  displayOrder      Int      @default(1)
  showInHomePage    Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([status])
  @@index([displayOrder])
  @@map("services")
}

model Doctor {
  id             String   @id @default(uuid())
  name           String
  designation    String
  specialization String
  bio            String?  @db.Text
  image          String?  @db.Text
  imageAlt       String?
  isActive       Boolean  @default(true)
  displayOrder   Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([isActive])
  @@index([displayOrder])
  @@map("doctors")
}

model ClinicPhoto {
  id           String   @id @default(uuid())
  heading      String
  description  String?  @db.Text
  image        String   @db.Text
  alt          String
  displayOrder Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([displayOrder])
  @@map("clinic_photos")
}

model PatientCase {
  id           String   @id @default(uuid())
  heading      String
  description  String?  @db.Text
  beforeImage  String   @db.Text
  afterImage   String   @db.Text
  beforeAlt    String
  afterAlt     String
  displayOrder Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([displayOrder])
  @@map("patient_cases")
}

