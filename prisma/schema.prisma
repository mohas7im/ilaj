generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  name         String?
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens RefreshToken[]

  @@map("user")
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model Service {
  id                String   @id @default(uuid())
  name              String
  slug              String   @unique
  description       String?  @db.Text
  details           String?  @db.Text
  image             String?  @db.Text
  imageAlt          String?
  secondaryImage    String?  @db.Text
  secondaryImageAlt String?
  // Optional SEO overrides for the treatment page; empty → name / description
  metaTitle         String?
  metaDescription   String?  @db.Text
  status            String   @default("active")
  displayOrder      Int      @default(1)
  showInHomePage    Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  faqs ServiceFaq[]

  @@index([status])
  @@index([displayOrder])
  @@map("services")
}

// A treatment's own FAQs, edited inside the Service form and shown on that
// treatment's page. Deleted with the service.
model ServiceFaq {
  id           String   @id @default(uuid())
  serviceId    String
  service      Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  question     String
  answer       String   @db.Text
  displayOrder Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([serviceId])
  @@map("service_faqs")
}

// General FAQs (home page), managed on the admin FAQs page.
model Faq {
  id           String   @id @default(uuid())
  question     String
  answer       String   @db.Text
  status       String   @default("published")
  displayOrder Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
  @@index([displayOrder])
  @@map("faqs")
}

model Doctor {
  id             String   @id @default(uuid())
  name           String
  designation    String
  specialization String
  bio            String?  @db.Text
  image          String?  @db.Text
  imageAlt       String?
  isActive       Boolean  @default(true)
  displayOrder   Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([isActive])
  @@index([displayOrder])
  @@map("doctors")
}

model ClinicPhoto {
  id           String   @id @default(uuid())
  heading      String
  description  String?  @db.Text
  image        String   @db.Text
  alt          String
  displayOrder Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([displayOrder])
  @@map("clinic_photos")
}

model PatientCase {
  id           String   @id @default(uuid())
  heading      String
  description  String?  @db.Text
  beforeImage  String   @db.Text
  afterImage   String   @db.Text
  beforeAlt    String
  afterAlt     String
  displayOrder Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([displayOrder])
  @@map("patient_cases")
}

model Testimonial {
  id           String   @id @default(uuid())
  patientName  String
  treatment    String
  rating       Float    @default(5.0)
  review       String   @db.Text
  status       String   @default("published")
  displayOrder Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
  @@index([displayOrder])
  @@map("testimonials")
}

model WhyChooseUsItem {
  id           String   @id @default(uuid())
  title        String
  description  String?  @db.Text
  displayOrder Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([displayOrder])
  @@map("why_choose_us_items")
}

model ClinicSettings {
  id                   String   @id @default(uuid())
  primaryEmail         String
  secondaryEmail       String?
  phone1               String
  phone2               String?
  whatsappNumber       String?
  address              String   @db.Text
  yearsOfExperience    String
  totalPatients        String
  specialists          String
  workingHoursWeekday  String
  workingHoursSaturday String
  sundayOpen           Boolean
  workingHoursSunday   String?
  facebook             String?
  instagram            String?
  linkedin             String?
  twitter              String?
  pinterest            String?
  mapLink              String?
  clinicName           String?
  tagline              String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@map("clinic_settings")
}

model Inquiry {
  id            String   @id @default(uuid())
  fullName      String
  email         String
  phone         String?
  treatment     String
  preferredDate String?
  preferredTime String?
  message       String   @db.Text
  status        String   @default("new")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([treatment])
  @@index([status])
  @@index([createdAt])
  @@map("inquiries")
}

// Global / site-wide SEO defaults — one row (singleton, like ClinicSettings).
model CommonSeo {
  id                 String   @id @default(uuid())
  siteName           String
  siteUrl            String
  defaultTitle       String
  defaultDescription String   @db.Text
  defaultOgImage     String?
  googleVerification String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("common_seo")
}

// Per-page SEO overrides. `page` is the slug from PAGE_OPTIONS (e.g. "home", "about")
// and doubles as the natural primary key — one row per page, no separate id needed.
model PageSeo {
  page        String   @id
  title       String
  description String   @db.Text
  ogImage     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("page_seo")
}



